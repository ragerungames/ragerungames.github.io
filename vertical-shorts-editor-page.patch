+  <section id="tools" class="band">
+    <div class="wrap">
+      <div class="sec-head">
+        <div>
+          <div class="eyebrow">Creator tools</div>
+          <h2>Tools for posting your game</h2>
+        </div>
+        <p>The tools we use to market our own games, for Windows.</p>
+      </div>
+      <div class="games">
+        <article class="game">
+          <div class="game-art">
+            <img src="tool-vertical-shorts-editor.webp" width="1200" height="630" alt="Vertical Shorts Editor: a Short of a toppling toy tower next to the editor" loading="lazy">
+          </div>
+          <div class="game-body">
+            <h3><a href="vertical-shorts-editor/" style="color:inherit;text-decoration:none">Vertical Shorts Editor</a></h3>
+            <p>Make Shorts of your game in minutes: timeline, big text, transitions, end cards and posting texts. $12.99, runs on your PC.</p>
+            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px">
+              <a class="btn btn-primary" data-track="vse-buy" href="https://ragerun.itch.io/vertical-shorts-editor" target="_blank" rel="noopener">Buy on itch.io<span class="vc" data-key="vse-buy"></span></a>
+              <a class="btn" data-track="vse-page" href="vertical-shorts-editor/">Tool page &rarr;</a>
+            </div>
+          </div>
+        </article>
+      </div>
+    </div>
+  </section>
